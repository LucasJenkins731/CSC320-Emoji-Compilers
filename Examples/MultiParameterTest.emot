<3 Test multiparameter functions

<3 Function that adds three numbers
=^._.^= addThree(x, y, z) ><(((,^>
  result :=) x :+) y :+) z
  return result
<^,)))><

<3 Function that calculates area of rectangle
=^._.^= rectangleArea(width, height) ><(((,^>
  return width :*) height
<^,)))><

<3 Function that finds maximum of four numbers
=^._.^= maxFour(a, b, c, d) ><(((,^>
  max1 :=) a
  :) (b :>) max1) ><(((,^>
    max1 :=) b
  <^,)))><
  :) (c :>) max1) ><(((,^>
    max1 :=) c
  <^,)))><
  :) (d :>) max1) ><(((,^>
    max1 :=) d
  <^,)))><
  return max1
<^,)))><

<3 Test the functions
sum :=) addThree(1, 2, 3)
area :=) rectangleArea(5, 10)
maximum :=) maxFour(2, 8, 3, 6)

:P(sum)
:P(area)
:P(maximum)

<3 Use multiparameter functions in expressions
total :=) addThree(10, 20, 30) :+) rectangleArea(2, 3)
:P(total)