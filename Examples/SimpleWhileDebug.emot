<3 Simple While Debug Test

counter :=) 3.0
zero :=) 0.0
one :=) 1.0

:P("Before loop, counter =")
:P(counter)

D:< (counter :>) zero) ><(((,^>
  :P("In loop, counter =")
  :P(counter)
  counter :=) counter :-) one
  :P("After decrement, counter =") 
  :P(counter)
<^,)))><

:P("After loop, final counter =")
:P(counter)