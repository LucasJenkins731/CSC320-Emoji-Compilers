<3 Collatz Conjecture Implementation

:P("=== COLLATZ CONJECTURE ===")

<3 Read the starting number
:P("Enter a number:")
n :=) -0-0-

steps :=) 0.0
max_val :=) n
<3 one :=) 1.0
<3 two :=) 2.0
<3 three :=) 3.0
<3 zero :=) 0.0

:P("Starting Collatz sequence for:")
:P(n)

<3 Main Collatz loop: while n != 1
D:< (n :!=) 1) 
><(((,^>
  <3 Check if current n > max_val
  :) (n :>) max_val) 
  ><(((,^>
    max_val :=) n
  <^,)))><

  <3 Check if n is even or odd
  <3 remainder :=) n :%) 2
  :) ((n :%) 2) :==) 0) 
  ><(((,^>
    <3 n is even: n = n / 2
    n :=) n :/) 2
  <^,)))><
  :(
  ><(((,^>
    <3 n is odd: n = 3 * n + 1
     <3 temp :=) 3 :*) n
     <3 n :=) temp :+) 1
     n :=) (3 :*) n) :+) 1
  <^,)))><
  steps :=) steps :+) 1
  

  <3 Check final value 1 for max (though usually smaller)  
  :) (n :>) max_val)
  ><(((,^>
    max_val :=) n
  <^,)))><
<^,)))><
<3 Print results
:P("steps = ")
:P(steps)
:P("max = ")
:P(max_val)