income :=) 0.0
income :=) -0-0-

rate :=) 0

:) (income :<) 10000.0) ><(((,^>
    rate :=) 0
<^,)))><
:| (income :<) 40000.0) ><(((,^>
    rate :=) 10
<^,)))><
:| (income :<) 80000.0) ><(((,^>
    rate :=) 20
<^,)))><
:( ><(((,^>
    rate :=) 30
<^,)))><

rate_decimal :=) rate :/) 100.0
tax :=) rate_decimal :*) income
net :=) income :-) tax

:P("income = ")
:P(income)
:P("rate = ")
:P(rate)
:P("tax = ")
:P(tax)
:P("net = ")
:P(net)