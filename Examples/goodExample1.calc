global :=) 100

<3 Function with parameter - parameter 'param' should be in function scope
=^._.^= myFunction() ><(((,^>
  param :=) 50
  local :=) param :+) 10
  result :=) local :*) 2
  :P(result)
  :P(global)
<^,)))><

=^._.^= anothaone() ><(((,^>
  param :=) 50
  local :=) param :+) 10
  result :=) local :*) 2
  :P(result)
  :P(global)
<^,)))><

anothaone()
myFunction()

<3 These should cause errors since they're out of scope
x :=) param
y :=) local
z :=) result