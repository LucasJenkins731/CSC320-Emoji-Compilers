<3 Problem 6 - Array Utilities (with multiparameter functions)

<3 Global array declaration
(o_o) A :=) [100]

<3 Function to calculate mean from sum and count
=^._.^= calculateMean(sum, count) ><(((,^>
  :) (count :>) 0) ><(((,^>
    return sum :/) count
  <^,)))><
  return 0.0
<^,)))><

<3 Function to calculate sum of array elements  
<3 Takes starting index and count as parameters
=^._.^= sumArrayElements(start, count) ><(((,^>
  total :=) 0.0
  i :=) 0
  D:< (i :<) count) ><(((,^>
    idx :=) start :+) i
    total :=) total :+) A[idx]
    i :=) i :+) 1
  <^,)))><
  return total
<^,)))><

<3 Function to find minimum value in array range
=^._.^= findMinValue(start, count) ><(((,^>
  :) (count :==) 0) ><(((,^>
    return 0.0
  <^,)))><
  
  minVal :=) A[start]
  i :=) 1
  D:< (i :<) count) ><(((,^>
    idx :=) start :+) i
    :) (A[idx] :<) minVal) ><(((,^>
      minVal :=) A[idx]
    <^,)))><
    i :=) i :+) 1
  <^,)))><
  return minVal
<^,)))><

<3 Function to find maximum value in array range  
=^._.^= findMaxValue(start, count) ><(((,^>
  :) (count :==) 0) ><(((,^>
    return 0.0
  <^,)))><
  
  maxVal :=) A[start]
  i :=) 1
  D:< (i :<) count) ><(((,^>
    idx :=) start :+) i
    :) (A[idx] :>) maxVal) ><(((,^>
      maxVal :=) A[idx]
    <^,)))><
    i :=) i :+) 1
  <^,)))><
  return maxVal
<^,)))><

<3 Main program starts here
<3 Read array size
n :=) -0-0-

<3 Validate input  
D:< (n :<) 0) ><(((,^>
    :P("Array dimensions N must not be negative. Try again.")
    n :=) -0-0-
<^,)))><

<3 Read array elements
i :=) 0
D:< (i :<) n) ><(((,^>
    val :=) -0-0-
    A[i] :=) val
    i :=) i :+) 1
<^,)))><

<3 Print array contents
:P("Array contents:")
i :=) 0
D:< (i :<) n) ><(((,^>
    :P(A[i])
    i :=) i :+) 1
<^,)))><

<3 Calculate sum using multiparameter function
total :=) sumArrayElements(0, n)

<3 Calculate mean using multiparameter function  
mean :=) calculateMean(total, n)

<3 Find min and max using multiparameter functions
min_val :=) findMinValue(0, n)
max_val :=) findMaxValue(0, n)

<3 Output results
:P("sum =")
:P(total)
:P("mean =")
:P(mean)
:P("min =")
:P(min_val)
:P("max =")
:P(max_val)