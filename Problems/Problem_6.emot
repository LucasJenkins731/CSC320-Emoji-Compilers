<3 Problem 6 - Array Utilities (without functions for now - inline implementation)

<3 Read array size
n :=) -0-0-

<3 Validate input
D:< (n :<) 0) ><(((,^>
    :P("Array dimensions N must not be negative. Try again.")
    n :=) -0-0-
<^,)))><

<3 Create and read array
(o_o) A :=) [100]
i :=) 0
D:< (i :<) n) ><(((,^>
    val :=) -0-0-
    A[i] :=) val
    i :=) i :+) 1
<^,)))><

<3 Print array (simplified - one per line)
:P("Array contents:")
i :=) 0
D:< (i :<) n) ><(((,^>
    :P(A[i])
    i :=) i :+) 1
<^,)))><

<3 Calculate sum inline
total :=) 0.0
i :=) 0
D:< (i :<) n) ><(((,^>
    total :=) total :+) A[i]
    i :=) i :+) 1
<^,)))><

<3 Calculate mean
mean :=) 0.0
:) (n :>) 0) ><(((,^>
    mean :=) total :/) n
<^,)))><

<3 Find min inline
min_val :=) 0.0
:) (n :>) 0) ><(((,^>
    min_val :=) A[0]
    i :=) 1
    D:< (i :<) n) ><(((,^>
        :) (A[i] :<) min_val) ><(((,^>
            min_val :=) A[i]
        <^,)))><
        i :=) i :+) 1
    <^,)))><
<^,)))><

<3 Find max inline
max_val :=) 0.0
:) (n :>) 0) ><(((,^>
    max_val :=) A[0]
    i :=) 1
    D:< (i :<) n) ><(((,^>
        :) (A[i] :>) max_val) ><(((,^>
            max_val :=) A[i]
        <^,)))><
        i :=) i :+) 1
    <^,)))><
<^,)))><

<3 Output results
:P("sum =")
:P(total)
:P("mean =")
:P(mean)  
:P("min =")
:P(min_val)
:P("max =")
:P(max_val)