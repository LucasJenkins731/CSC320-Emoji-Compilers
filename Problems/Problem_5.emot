<3 Problem 5 - Matrix Multiplication

n :=) -0-0-

<3 Create matrices A, B, and C (flattened as 1D arrays)
<3 A[i*n + j] represents A[i][j]
(o_o) A :=) [100]
(o_o) B :=) [100]
(o_o) C :=) [100]

<3 Read matrix A
i :=) 0
D:< (i :<) n) ><(((,^>
    j :=) 0
    D:< (j :<) n) ><(((,^>
        idx :=) i :*) n :+) j
        A[idx] :=) -0-0-
        j :=) j :+) 1
    <^,)))><
    i :=) i :+) 1
<^,)))><

<3 Read matrix B
i :=) 0
D:< (i :<) n) ><(((,^>
    j :=) 0
    D:< (j :<) n) ><(((,^>
        idx :=) i :*) n :+) j
        B[idx] :=) -0-0-
        j :=) j :+) 1
    <^,)))><
    i :=) i :+) 1
<^,)))><

<3 Initialize matrix C with zeros
i :=) 0
D:< (i :<) n) ><(((,^>
    j :=) 0
    D:< (j :<) n) ><(((,^>
        idx :=) i :*) n :+) j
        C[idx] :=) 0.0
        j :=) j :+) 1
    <^,)))><
    i :=) i :+) 1
<^,)))><

<3 Compute C = A * B
i :=) 0
D:< (i :<) n) ><(((,^>
    j :=) 0
    D:< (j :<) n) ><(((,^>
        <3 Compute C[i][j]
        s :=) 0.0
        k :=) 0
        D:< (k :<) n) ><(((,^>
            a_idx :=) i :*) n :+) k
            b_idx :=) k :*) n :+) j
            s :=) s :+) (A[a_idx] :*) B[b_idx])
            k :=) k :+) 1
        <^,)))><
        c_idx :=) i :*) n :+) j
        C[c_idx] :=) s
        j :=) j :+) 1
    <^,)))><
    i :=) i :+) 1
<^,)))><

<3 Print matrix C
i :=) 0
D:< (i :<) n) ><(((,^>
    j :=) 0
    D:< (j :<) n) ><(((,^>
        c_idx :=) i :*) n :+) j
        :P(C[c_idx])
        j :=) j :+) 1
    <^,)))><
    i :=) i :+) 1
<^,)))><
