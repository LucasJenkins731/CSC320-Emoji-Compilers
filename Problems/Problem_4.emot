<3 Problem 4 - Temperature Analyzer

n :=) -0-0-

<3 Validate input
D:< (n :<=) 0) ><(((,^>
    :P("Array size N must be positive. Try again.")
    n :=) -0-0-
<^,)))><

<3 Create temperature array
(o_o) T :=) [100]

<3 Read temperature values
i :=) 0
D:< (i :<) n) ><(((,^>
    T[i] :=) -0-0-
    i :=) i :+) 1
<^,)))><

<3 Initialize with first temperature
total :=) T[0]
mn :=) T[0]
mx :=) T[0]

<3 Process remaining temperatures
i :=) 1
D:< (i :<) n) ><(((,^>
    val :=) T[i]
    total :=) total :+) val
    
    :) (val :<) mn) ><(((,^>
        mn :=) val
    <^,)))><
    
    :) (val :>) mx) ><(((,^>
        mx :=) val
    <^,)))><
    
    i :=) i :+) 1
<^,)))><

<3 Calculate mean
mean :=) total :/) n

<3 Count days above mean
count_above :=) 0
i :=) 0
D:< (i :<) n) ><(((,^>
    :) (T[i] :>) mean) ><(((,^>
        count_above :=) count_above :+) 1
    <^,)))><
    i :=) i :+) 1
<^,)))><

<3 Output results
:P("mean =")
:P(mean)
:P("min =")
:P(mn)
:P("max =")
:P(mx)
:P("above_mean =")
:P(count_above)