<3 Emoticon language version of problem2_running_stats.py

<3 Read integer n
n :=) 0
n :=) -0-0-

<3 Initialize with first value
first_val :=) 0.0
first_val :=) -0-0-

total :=) first_val
mn :=) first_val
mx :=) first_val

<3 Initialize counters
pos :=) 0
neg :=) 0  
zero :=) 0

<3 Count positive, negative, and zero values for first value
:) (first_val :>) 0) ><(((,^>
    pos :=) 1
<^,)))><
:| (first_val :<) 0) ><(((,^>
    neg :=) 1
<^,)))><
:( ><(((,^>
    zero :=) 1
<^,)))><

<3 Loop through remaining values
i :=) 1
D:< (i :<) n) ><(((,^>
    x :=) 0.0
    x :=) -0-0-
    total :=) total :+) x

    :) (x :<) mn) ><(((,^>
        mn :=) x
    <^,)))><
    
    :) (x :>) mx) ><(((,^>
        mx :=) x
    <^,)))><

    :) (x :>) 0) ><(((,^>
        pos :=) pos :+) 1
    <^,)))><
    :| (x :<) 0) ><(((,^>
        neg :=) neg :+) 1
    <^,)))><
    :( ><(((,^>
        zero :=) zero :+) 1
    <^,)))><

    i :=) i :+) 1
<^,)))><

:P("sum = ")
:P(total)
:P("min = ")
:P(mn)
:P("max = ")
:P(mx)
:P("pos = ")
:P(pos)
:P("neg = ")
:P(neg)
:P("zero = ")
:P(zero)
