<3 Problem 7 - Sorted Queries with multiparameter functions

<3 Global array declaration
(o_o) A :=) [100]

<3 Function to perform bubble sort on array range
=^._.^= bubbleSort(start, count) ><(((,^>
  pass :=) 0
  D:< (pass :<) count) ><(((,^>
    i :=) start
    limit :=) start :+) count :-) pass :-) 1
    D:< (i :<) limit) ><(((,^>
      nextIdx :=) i :+) 1
      :) (A[i] :>) A[nextIdx]) ><(((,^>
        temp :=) A[i]
        A[i] :=) A[nextIdx]
        A[nextIdx] :=) temp
      <^,)))><
      i :=) i :+) 1
    <^,)))><
    pass :=) pass :+) 1
  <^,)))><
  return 0
<^,)))><

<3 Function to print array range
=^._.^= printArray(start, count) ><(((,^>
  :P("Sorted array:")
  i :=) 0
  D:< (i :<) count) ><(((,^>
    idx :=) start :+) i
    :P(A[idx])
    i :=) i :+) 1
  <^,)))><
  return 0
<^,)))><

<3 Function to perform linear search in array range
=^._.^= linearSearch(start, count, target) ><(((,^>
  i :=) 0
  D:< (i :<) count) ><(((,^>
    idx :=) start :+) i
    :) (A[idx] :==) target) ><(((,^>
      return idx
    <^,)))><
    i :=) i :+) 1
  <^,)))><
  return -1
<^,)))><

<3 Function to calculate middle index for binary search
=^._.^= getMidpoint(left, right) ><(((,^>
  return (left :+) right) :/) 2
<^,)))><

<3 Function to perform simple binary search (iterative)
=^._.^= binarySearchIterative(left, right, target) ><(((,^>
  currentLeft :=) left
  currentRight :=) right
  
  D:< (currentLeft :<=) currentRight) ><(((,^>
    mid :=) (currentLeft :+) currentRight) :/) 2
    :) (A[mid] :==) target) ><(((,^>
      return mid
    <^,)))><
    
    :) (target :<) A[mid]) ><(((,^>
      currentRight :=) mid :-) 1
    <^,)))><
    :(
    ><(((,^>
      currentLeft :=) mid :+) 1
    <^,)))><
  <^,)))><
  
  return -1
<^,)))><

<3 Main program starts here
n :=) -0-0-

<3 Validate input
D:< (n :<=) 0) ><(((,^>
    :P("Array dimensions N must be positive. Try again.")
    n :=) -0-0-
<^,)))><

<3 Read array elements
i :=) 0
D:< (i :<) n) ><(((,^>
    A[i] :=) -0-0-
    i :=) i :+) 1
<^,)))><

<3 Sort the array using multiparameter bubble sort
result :=) bubbleSort(0, n)

<3 Print sorted array
result :=) printArray(0, n)

<3 Process queries
q :=) -0-0-
queryCount :=) 0
D:< (queryCount :<) q) ><(((,^>
    target :=) -0-0-
    result :=) binarySearchIterative(0, n :-) 1, target)
    
    :) (result :==) -1) ><(((,^>
        :P("not found")
    <^,)))><
    :) (result :!=) -1) ><(((,^>
        :P("found at index")
        :P(result)
    <^,)))><
    
    queryCount :=) queryCount :+) 1
<^,)))><