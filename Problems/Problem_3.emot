<3 Problem 3 - Collatz Steps

n :=) -0-0-

steps :=) 0
max_val :=) n

<3 Collatz sequence loop
D:< (n :!=) 1) ><(((,^>
    <3 Update max value if current n is larger
    :) (n :>) max_val) ><(((,^>
        max_val :=) n
    <^,)))><
    
    <3 Collatz step: if even divide by 2, if odd multiply by 3 and add 1
    remainder :=) n :%) 2
    :) (remainder :==) 0) ><(((,^>
        <3 n is even: n = n / 2
        n :=) n :/) 2
    <^,)))><
    :( ><(((,^>
        <3 n is odd: n = 3 * n + 1
        n :=) (3 :*) n) :+) 1
    <^,)))><
    
    steps :=) steps :+) 1
<^,)))><

<3 Check final value 1 for max (though usually smaller)
:) (n :>) max_val) ><(((,^>
    max_val :=) n
<^,)))><

<3 Output results
:P("steps =")
:P(steps)
:P("max =")
:P(max_val)
