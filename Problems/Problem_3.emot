<3 Read n
n :=) 1
n :=) -0-0-

<3 Create array A of size n
(o_o) A :=) [100]

<3 Read n values into array A
i :=) 0
D:< (i :<) n) ><(((,^>
    temp :=) 0
    temp :=) -0-0-
    A[i] :=) temp
    i :=) i :+) 1
<^,)))><

<3 Compute sum of A
sumA :=) 0
i :=) 0
D:< (i :<) n) ><(((,^>
    sumA :=) sumA :+) A[i]
    i :=) i :+) 1
<^,)))><

<3 Compute mean
mean :=) 0.0
:) (n :>) 0) ><(((,^>
    mean :=) sumA :/) n
<^,)))><

<3 Create array B of size n
(o_o) B :=) [100]

<3 Build B[i] = A[i] - mean
i :=) 0
D:< (i :<) n) ><(((,^>
    B[i] :=) A[i] :-) mean
    i :=) i :+) 1
<^,)))><

<3 Print B, one per line
i :=) 0
D:< (i :<) n) ><(((,^>
    :P(B[i])
    i :=) i :+) 1
<^,)))><
